# Public URL this gateway is reached at, e.g.:
#   https://auth.example.com
BASE_URL=

# Canonical URI of the protected resource this gateway is guarding — the
# thing an MCP client will actually connect to, e.g.:
#   https://mcp.example.com/mcp
RESOURCE_URL=

# "oidc" for any OIDC-compliant identity provider (Google, Microsoft/Azure
# AD, Okta, Auth0, Keycloak, Authentik, GitLab, ...), or "github".
AUTH_PROVIDER=oidc

# Only used when AUTH_PROVIDER=oidc — the issuer base URL. Discovery is
# fetched from `${OIDC_ISSUER_URL}/.well-known/openid-configuration`.
#   Google:    https://accounts.google.com
#   Microsoft: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER_URL=

# OAuth app credentials from your identity provider. The redirect/callback
# URL registered with the provider must be exactly:
#   ${BASE_URL}/oauth/callback
CLIENT_ID=
CLIENT_SECRET=

# Comma-separated list of verified emails allowed to sign in. This is the
# entire access-control list for who can mint a token.
ALLOWED_EMAILS=

DB_PATH=/data/tokens.db
# Internal port Node listens on. Only relevant when running `pnpm start`
# directly (no reverse proxy in front) — the Docker image bundles nginx in
# front of this and publishes port 80 instead; see UPSTREAM_URL in
# examples/docker-compose/.env.example for that mode.
PORT=4000
