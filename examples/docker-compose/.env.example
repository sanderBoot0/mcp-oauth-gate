# Copy to .env in this directory before `docker compose up`.
# For a real deployment, replace these localhost values with your actual
# public URL and fill in real identity-provider credentials.

BASE_URL=http://localhost:8080
RESOURCE_URL=http://localhost:8080/mcp

# Internal address of the service being protected — scheme+host+port only,
# no path (the gateway forwards the original request path unchanged).
# `protected-service` is this compose file's placeholder; point this at
# your real service.
UPSTREAM_URL=http://protected-service:80

AUTH_PROVIDER=oidc
OIDC_ISSUER_URL=https://accounts.google.com
CLIENT_ID=
CLIENT_SECRET=

ALLOWED_EMAILS=

# Only needed if you put another reverse proxy in front of this container
# (see docs/reverse-proxy.md) — set to that proxy's IP/CIDR so nginx trusts
# its X-Forwarded-For header for rate-limiting, instead of rate-limiting
# every real client behind it as if they were one. Leave unset otherwise.
TRUSTED_PROXY_CIDR=
