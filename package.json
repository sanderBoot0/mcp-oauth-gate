{
    "name": "mcp-oauth-gate",
    "version": "0.1.0",
    "description": "Self-hostable OAuth 2.1 authorization server + forward-auth gateway for MCP servers and other HTTP services.",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/main.js",
        "dev": "tsx watch src/main.ts",
        "tokens": "node dist/scripts/tokens.js",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "better-sqlite3": "11.10.0",
        "express": "4.22.3",
        "jose": "5.10.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/better-sqlite3": "7.6.13",
        "@types/express": "4.17.25",
        "@types/node": "26.6.1",
        "@types/supertest": "7.2.1",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.8",
        "supertest": "7.2.2",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1",
        "vitest": "5.0.1"
    }
}
