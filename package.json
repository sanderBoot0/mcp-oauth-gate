{
    "name": "mcp-oauth-gate",
    "version": "0.1.0",
    "description": "Self-hostable OAuth 2.1 authorization server, in one container, for putting real login (Google/Okta/GitHub/any OIDC provider) in front of an MCP server or any other HTTP service.",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "oauth",
        "oauth2",
        "oauth2.1",
        "authorization-server",
        "authentication",
        "pkce",
        "dynamic-client-registration",
        "device-authorization-grant",
        "oidc",
        "openid-connect",
        "nginx",
        "docker",
        "self-hosted"
    ],
    "homepage": "https://github.com/sanderBoot0/mcp-oauth-gate#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sanderBoot0/mcp-oauth-gate.git"
    },
    "bugs": {
        "url": "https://github.com/sanderBoot0/mcp-oauth-gate/issues"
    },
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/main.js",
        "dev": "tsx watch src/main.ts",
        "tokens": "node dist/scripts/tokens.js",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:smoke": "cd bruno/mcp-oauth-gate && bru run --env compose"
    },
    "dependencies": {
        "better-sqlite3": "13.0.3",
        "express": "5.2.1",
        "jose": "6.2.12",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/better-sqlite3": "7.6.13",
        "@types/express": "5.0.6",
        "@types/node": "26.6.2",
        "@types/supertest": "6.0.3",
        "@usebruno/cli": "4.1.0",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.8",
        "supertest": "7.2.2",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1",
        "vitest": "5.0.1"
    },
    "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
